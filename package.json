{
  "name": "@a3d/a3d-components",
  "version": "0.1.0",
  "description": "3D component library based on Three.js — general, heat, material components with utility tools",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/es/index.js",
  "types": "./dist/es/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/es/core.d.ts",
        "default": "./dist/es/core.js"
      },
      "require": {
        "types": "./dist/cjs/core.d.ts",
        "default": "./dist/cjs/core.cjs"
      }
    },
    "./heat": {
      "import": {
        "types": "./dist/es/heat.d.ts",
        "default": "./dist/es/heat.js"
      },
      "require": {
        "types": "./dist/cjs/heat.d.ts",
        "default": "./dist/cjs/heat.cjs"
      }
    },
    "./material": {
      "import": {
        "types": "./dist/es/material.d.ts",
        "default": "./dist/es/material.js"
      },
      "require": {
        "types": "./dist/cjs/material.d.ts",
        "default": "./dist/cjs/material.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/es/utils.d.ts",
        "default": "./dist/es/utils.js"
      },
      "require": {
        "types": "./dist/cjs/utils.d.ts",
        "default": "./dist/cjs/utils.cjs"
      }
    },
    "./graph": {
      "import": {
        "types": "./dist/es/graph.d.ts",
        "default": "./dist/es/graph.js"
      },
      "require": {
        "types": "./dist/cjs/graph.d.ts",
        "default": "./dist/cjs/graph.cjs"
      }
    },
    "./controls": {
      "import": {
        "types": "./dist/es/controls.d.ts",
        "default": "./dist/es/controls.js"
      },
      "require": {
        "types": "./dist/cjs/controls.d.ts",
        "default": "./dist/cjs/controls.cjs"
      }
    },
    "./camera": {
      "import": {
        "types": "./dist/es/camera.d.ts",
        "default": "./dist/es/camera.js"
      },
      "require": {
        "types": "./dist/cjs/camera.d.ts",
        "default": "./dist/cjs/camera.cjs"
      }
    },
    "./interactive": {
      "import": {
        "types": "./dist/es/interactive.d.ts",
        "default": "./dist/es/interactive.js"
      },
      "require": {
        "types": "./dist/cjs/interactive.d.ts",
        "default": "./dist/cjs/interactive.cjs"
      }
    },
    "./helper": {
      "import": {
        "types": "./dist/es/helper.d.ts",
        "default": "./dist/es/helper.js"
      },
      "require": {
        "types": "./dist/cjs/helper.d.ts",
        "default": "./dist/cjs/helper.cjs"
      }
    },
    "./animation": {
      "import": {
        "types": "./dist/es/animation.d.ts",
        "default": "./dist/es/animation.js"
      },
      "require": {
        "types": "./dist/cjs/animation.d.ts",
        "default": "./dist/cjs/animation.cjs"
      }
    },
    "./docs": "./docs/components.json",
    "./dist/*": "./dist/*"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "docs/components.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "threejs",
    "3d",
    "components",
    "webgl"
  ],
  "license": "MIT",
  "peerDependencies": {
    "gsap": ">=3.0.0",
    "three": ">=0.150.0",
    "three-bvh-csg": ">=0.0.16",
    "three-mesh-bvh": ">=0.9.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.183.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "gsap": "^3.15.0",
    "highlight.js": "^11.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "three": "^0.183.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.10",
    "typedoc": "^0.28.19",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "docs": "typedoc",
    "gen:component-docs": "node scripts/gen-component-docs.mjs",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "docs:serve": "vite docs --open --port 7777",
    "prepublishOnly": "npm run build",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": "eslint --fix --max-warnings 0 --no-warn-ignored"
  }
}
